# Copy to .env.local (development) or set in your hosting provider (production).
# Values are baked into the site at build time: rebuild after changing them.

# Full URL of the consultation API (POST, see docs/consultation-api.md).
# Leave empty to run the contact form in preview mode (nothing is delivered).
VITE_ENQUIRY_ENDPOINT=https://api.example.com/api/v1/enquiries
